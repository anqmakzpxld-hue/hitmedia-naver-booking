{
  "name": "hitmedia-naver-booking",
  "version": "0.1.0",
  "description": "히트미디어 네이버 예약 알림 프로그램 (POS용)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "kr.co.jeonbaeyeon.naverbooking",
    "productName": "히트미디어 예약 알림",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "popup.html",
      "setup.html"
    ]
  }
}
